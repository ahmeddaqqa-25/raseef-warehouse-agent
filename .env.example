# Raseef settings. Leave everything empty to run in offline demo mode (no key needed).
# Fill ONE of the options below, save, and restart run.bat.

# Option A - Anthropic (Claude)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Option B - OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Option C - free and local with Ollama (install from ollama.com, then: ollama pull qwen2.5:7b)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:7b

# Force a mode: auto | anthropic | openai | offline
LLM_PROVIDER=auto
